NODE_ENV=development
PORT=3000
APP_VERSION=0.1.0

CRM_DB_SERVER=localhost
CRM_DB_PORT=1433
CRM_DB_DATABASE=dio_crm
CRM_DB_USER=crm_app
CRM_DB_PASSWORD=CHANGE_ME
CRM_DB_ENCRYPT=false
CRM_DB_POOL_MAX=20
CRM_DB_CONNECT_TIMEOUT_MS=10000
CRM_DB_REQUEST_TIMEOUT_MS=30000
CRM_DB_SLOW_QUERY_MS=1500

JWT_ACCESS_SECRET=CHANGE_ME_ACCESS
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=14

CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
SLOW_REQUEST_MS=2000

INTERFACE_CIRCUIT_FAILURES=5
INTERFACE_CIRCUIT_RESET_MS=60000

FILE_STORAGE_ROOT=./storage
