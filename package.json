{
  "name": "dio-crm",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r --if-present test",
    "regression:multi-market": "node scripts/regression/multi-market-ui-check.mjs",
    "i18n:check": "node scripts/i18n/check.mjs",
    "i18n:hardcode": "node scripts/i18n/hardcode-check.mjs",
    "pwa:check": "node scripts/pwa/check.mjs",
    "env:check": "node scripts/deploy/devuat-migration-plan.mjs --target DEV && node scripts/pilot/mobile-pwa-readiness.mjs && node scripts/integration/external-readiness.mjs",
    "pilot:mobile": "node scripts/pilot/mobile-pwa-readiness.mjs",
    "devuat:plan": "node scripts/deploy/devuat-migration-plan.mjs --target DEV",
    "integration:check": "node scripts/integration/external-readiness.mjs",
    "audit:critical": "pnpm audit --audit-level=critical",
    "dev:api": "pnpm --filter @dio-crm/api start:dev",
    "dev:web": "pnpm --filter @dio-crm/web dev",
    "dev:admin:api": "node scripts/admin/dev.cjs api",
    "dev:admin:web": "node scripts/admin/dev.cjs web",
    "dev:admin:browser": "node scripts/admin/dev.cjs browser",
    "test:admin:contracts": "pnpm --filter @dio-crm/api exec jest --runInBand src/modules/admin/memory.repository.spec.ts src/modules/admin/contracts.spec.ts",
    "test:admin:api": "node --test tests/admin/api.cjs tests/admin/legacy-auth.cjs tests/admin/legacy-http.cjs tests/admin/organization.cjs",
    "test:admin:browser": "node scripts/admin/run-web-test.cjs tests/admin/browser.cjs",
    "test:admin:baseline": "node scripts/admin/run-web-test.cjs scripts/admin/baseline.cjs",
    "test:admin:entry": "node scripts/admin/run-entry-tests.cjs"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
